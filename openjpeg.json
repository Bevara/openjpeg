{
    "name": "openjpeg",
    "description": "JP2000 decoder",
    "filters":["rfjp2","j2kdec"],
    "help": "This filter decodes JPEG2000 streams through OpenJPEG library.",
    "support": [
        "image"
    ],
    "sources":"https://bevara.ddns.net/sources/openjpeg.accessor",
    "filter_source":{
        "rfjp2" : "reframe_jp2.c",
        "j2kdec" : "dec_j2k.c"
    },
    "Format": ["JPEG 2000","j2k1"],
    "using": ["solver_minimal_1", "solver_1"],
    "runtime": {
        "j2kdec": {
            "outputs": [
                {
                    "property": "GF_PROP_PID_PIXFMT",
                    "format": [
                        "GF_PIXEL_GREYSCALE",
                        "GF_PIXEL_ALPHAGREY",
                        "GF_PIXEL_RGBA",
                        "GF_PIXEL_RGB",
                        "GF_PIXEL_YUV"
                    ]
                }
            ]
        }
    },
    "patents": {
        "status": "royalty-free",
        "note": "JPEG 2000 Part 1, royalty-free",
        "checked": "2026-10-16"
    }
}
